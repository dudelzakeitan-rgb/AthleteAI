{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-native",
    "strict": false,
    "types": [
      "nativewind/types"
    ]
  },
  "include": [
    "App.tsx",
    "index.js",
    "global.css",
    "src/screens/**/*.ts",
    "src/screens/**/*.tsx",
    "src/navigation/**/*.ts",
    "src/navigation/**/*.tsx",
    "src/context/**/*.ts",
    "src/context/**/*.tsx",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/pages",
    "src/components",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts"
  ]
}